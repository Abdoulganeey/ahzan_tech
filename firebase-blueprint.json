{
  "entities": {
    "BuyerProfile": {
      "title": "BuyerProfile",
      "description": "Authenticated B2B buyer workspace profile isolated per user UID, or admin-synced Lithium Intel buyer account record.",
      "type": "object",
      "properties": {
        "buyerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "rankId": { "type": "number" },
        "normalizedCompanyKey": { "type": "string", "maxLength": 120 },
        "companyName": { "type": "string", "minLength": 2, "maxLength": 160 },
        "contactName": { "type": "string", "maxLength": 120 },
        "email": { "type": "string", "format": "email", "maxLength": 160 },
        "defaultPort": { "type": "string", "maxLength": 120 },
        "leadCategory": { "type": "string", "enum": ["LITHIUM", "AFRICA_SOURCING", "FUNDING_FINANCE"] },
        "regionCode": { "type": "string", "maxLength": 64 },
        "crmStage": { "type": "string", "enum": ["PROSPECT", "CONTACTED", "QUALIFIED", "PROPOSAL_QUOTE", "NEGOTIATION", "WON", "LOST"] },
        "outreachStatus": { "type": "string", "maxLength": 40 },
        "priorityScore": { "type": "number" },
        "priorityTier": { "type": "string", "enum": ["A", "B", "C"] },
        "targetFobValue": { "type": "number" },
        "lastUpdatedMillis": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["companyName", "createdAt", "updatedAt"]
    },
    "BuyerRfq": {
      "title": "BuyerRfq",
      "description": "B2B Request for Quote or Letter of Intent linked optionally to Lithium Intel leadRankId.",
      "type": "object",
      "properties": {
        "buyerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
