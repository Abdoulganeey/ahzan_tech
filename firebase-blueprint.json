      "description": "Admin-managed CRM email logs and activity timeline feed."
    },
    "/crmTasks/{taskId}": {
      "schema": { "$ref": "#/entities/CrmTask" },
      "description": "Admin-managed CRM follow-up task checklist."
    }
  }
}
