        "companyName": { "type": "string", "minLength": 2, "maxLength": 160 },
        "contactName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "corporateEmail": { "type": "string", "format": "email", "minLength": 5, "maxLength": 160 },
        "destinationPort": { "type": "string", "minLength": 2, "maxLength": 120 },
        "commoditySummary": { "type": "string", "minLength": 2, "maxLength": 300 },
        "productDescription": { "type": "string", "maxLength": 400 },
        "targetVolume": { "type": "string", "minLength": 1, "maxLength": 120 },
        "quantityMt": { "type": "number" },
        "unitPriceUsd": { "type": "number" },
        "totalValueUsd": { "type": "number" },
        "incoterm": { "type": "string", "enum": ["EXW", "FOB", "CFR", "CIF", "DAP"] },
        "paymentTerms": { "type": "string", "minLength": 2, "maxLength": 120 },
        "validityDays": { "type": "number" },
        "specifications": { "type": "string", "maxLength": 1000 },
        "status": { "type": "string", "enum": ["Submitted", "Under Executive Review", "Quote Approved", "Not Approved", "SCO / Proforma Issued", "L/C Confirmed", "Export Cleared"] },
        "reviewNote": { "type": "string", "maxLength": 500 },
        "reviewedBy": { "type": "string", "maxLength": 160 },
        "reviewedAtMillis": { "type": "number" },
        "estimatedValueUsd": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["buyerUid", "refId", "companyName", "contactName", "corporateEmail", "destinationPort", "commoditySummary", "targetVolume", "incoterm", "paymentTerms", "status", "createdAt", "updatedAt"]
    },
    "BuyerShipment": {
      "title": "BuyerShipment",
      "description": "Export shipment tracking record linked optionally to Lithium Intel leadRankId.",
      "type": "object",
      "properties": {
        "buyerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "trackingCode": { "type": "string", "minLength": 4, "maxLength": 48, "pattern": "^[a-zA-Z0-9_\\-]+$" },
