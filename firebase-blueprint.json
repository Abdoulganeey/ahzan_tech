        "lastUpdateNote": { "type": "string", "minLength": 4, "maxLength": 320 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["buyerUid", "trackingCode", "rfqRefId", "commodity", "originPort", "destinationPort", "vesselName", "billOfLadingNo", "containerAllocation", "stageIndex", "status", "etaDate", "lastUpdateNote", "createdAt", "updatedAt"]
    },
    "TradeDocument": {
      "title": "TradeDocument",
      "description": "Verified trade certificates, B/L records, and Document Studio formal PDF issuances (AZT-PL..AZT-NCN).",
      "type": "object",
      "properties": {
        "buyerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "docCode": { "type": "string", "minLength": 4, "maxLength": 48, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "referenceNo": { "type": "string", "maxLength": 64 },
        "title": { "type": "string", "minLength": 3, "maxLength": 180 },
        "docType": { "type": "string", "enum": ["Proforma Invoice", "SGS Assay Certificate", "Bill of Lading", "Certificate of Origin", "Phytosanitary Certificate", "Form NXP / NESS Clearance", "PRICE_LIST", "LOI", "MOU", "FCO", "PROFORMA_INVOICE", "SALES_CONTRACT", "MANDATE_NCNDA"] },
        "rfqRefId": { "type": "string", "minLength": 4, "maxLength": 40, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "leadRankId": { "type": "number" },
        "counterpartyCompany": { "type": "string", "maxLength": 160 },
        "commodity": { "type": "string", "minLength": 2, "maxLength": 160 },
        "issuer": { "type": "string", "minLength": 2, "maxLength": 120 },
        "issuedDate": { "type": "string", "minLength": 4, "maxLength": 40 },
        "status": { "type": "string", "enum": ["Verified", "Approved", "Pending Review", "Pending Countersignature", "Not Approved", "Archived"] },
        "reviewNote": { "type": "string", "maxLength": 500 },
        "reviewedBy": { "type": "string", "maxLength": 160 },
        "reviewedAtMillis": { "type": "number" },
        "incoterm": { "type": "string", "enum": ["EXW", "FOB", "CFR", "CIF", "DAP"] },
        "totalValue": { "type": "number" },
        "createdAtMillis": { "type": "number" },
        "summaryText": { "type": "string", "minLength": 4, "maxLength": 1500 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["buyerUid", "docCode", "title", "docType", "rfqRefId", "commodity", "issuer", "issuedDate", "status", "summaryText", "createdAt", "updatedAt"]
    },
    "PriceAlert": {
      "title": "PriceAlert",
      "description": "Commodity price fluctuation alert subscription.",
      "type": "object",
      "properties": {
        "buyerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "minLength": 5, "maxLength": 160 },
        "commodityKey": { "type": "string", "minLength": 2, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "commodityLabel": { "type": "string", "minLength": 2, "maxLength": 160 },
        "category": { "type": "string", "enum": ["Critical Minerals", "Agro-Commodities", "Lubricants"] },
        "baselinePrice": { "type": "number" },
        "unitLabel": { "type": "string", "minLength": 1, "maxLength": 32 },
        "triggerDirection": { "type": "string", "enum": ["below", "above", "pct_change"] },
        "thresholdValue": { "type": "number" },
        "channel": { "type": "string", "enum": ["email", "email_whatsapp"] },
        "status": { "type": "string", "enum": ["Active", "Paused"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["buyerUid", "email", "commodityKey", "commodityLabel", "category", "baselinePrice", "unitLabel", "triggerDirection", "thresholdValue", "channel", "status", "createdAt", "updatedAt"]
    },
