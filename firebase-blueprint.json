{
  "entities": {
    "BuyerProfile": {
      "title": "BuyerProfile",
      "description": "Authenticated B2B buyer workspace profile isolated per user UID.",
      "type": "object",
      "properties": {
        "buyerUid": {
          "type": "string",
          "description": "Firebase Auth UID of the buyer.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "companyName": {
          "type": "string",
          "description": "Registered buyer organization name.",
          "minLength": 2,
          "maxLength": 160
        },
        "contactName": {
          "type": "string",
          "description": "Authorized buyer representative.",
          "minLength": 2,
          "maxLength": 120
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Corporate email address of the buyer.",
          "minLength": 5,
          "maxLength": 160
        },
        "defaultPort": {
          "type": "string",
          "description": "Default destination discharge port.",
          "minLength": 2,
          "maxLength": 120
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "buyerUid",
        "companyName",
        "contactName",
        "email",
        "defaultPort",
        "createdAt",
        "updatedAt"
      ]
    },
    "BuyerRfq": {
      "title": "BuyerRfq",
      "description": "B2B Request for Quote or Letter of Intent submitted by an authenticated buyer.",
      "type": "object",
      "properties": {
        "buyerUid": {
          "type": "string",
          "description": "Owner Firebase Auth UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "refId": {
          "type": "string",
          "description": "Unique RFQ reference code.",
          "minLength": 4,
          "maxLength": 40,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "companyName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 160
        },
        "contactName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "corporateEmail": {
          "type": "string",
          "format": "email",
          "minLength": 5,
          "maxLength": 160
        },
        "destinationPort": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "commoditySummary": {
          "type": "string",
          "minLength": 2,
          "maxLength": 300
        },
        "targetVolume": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "incoterm": {
          "type": "string",
          "enum": ["EXW", "FOB", "CFR", "CIF", "DAP"]
        },
        "paymentTerms": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "specifications": {
          "type": "string",
          "maxLength": 1000
        },
        "status": {
          "type": "string",
          "enum": [
            "Submitted",
            "Under Executive Review",
            "SCO / Proforma Issued",
            "L/C Confirmed",
            "Export Cleared"
          ]
        },
        "estimatedValueUsd": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "buyerUid",
        "refId",
        "companyName",
        "contactName",
        "corporateEmail",
        "destinationPort",
        "commoditySummary",
        "targetVolume",
        "incoterm",
        "paymentTerms",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "BuyerShipment": {
      "title": "BuyerShipment",
      "description": "Export shipment tracking record linked to an authenticated buyer.",
      "type": "object",
      "properties": {
        "buyerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "trackingCode": {
          "type": "string",
          "minLength": 4,
          "maxLength": 48,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "rfqRefId": {
          "type": "string",
          "minLength": 4,
          "maxLength": 40,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "commodity": {
          "type": "string",
          "minLength": 2,
          "maxLength": 180
        },
        "originPort": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "destinationPort": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "vesselName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "billOfLadingNo": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "containerAllocation": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "stageIndex": {
          "type": "number"
        },
        "status": {
          "type": "string",
          "enum": [
            "Mine / Farm Gate",
            "SGS Assay Verification",
            "NESS & Customs Cleared",
            "In Ocean Transit",
            "Discharged at Port"
          ]
        },
        "etaDate": {
          "type": "string",
          "minLength": 4,
          "maxLength": 40
        },
        "lastUpdateNote": {
          "type": "string",
          "minLength": 4,
          "maxLength": 320
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "buyerUid",
        "trackingCode",
        "rfqRefId",
        "commodity",
        "originPort",
        "destinationPort",
        "vesselName",
        "billOfLadingNo",
        "containerAllocation",
        "stageIndex",
        "status",
        "etaDate",
        "lastUpdateNote",
        "createdAt",
        "updatedAt"
      ]
    },
    "TradeDocument": {
      "title": "TradeDocument",
      "description": "Historical and active verified trade documentation for an authenticated buyer.",
      "type": "object",
      "properties": {
        "buyerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "docCode": {
          "type": "string",
          "minLength": 4,
          "maxLength": 48,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 3,
          "maxLength": 180
        },
        "docType": {
          "type": "string",
          "enum": [
            "Proforma Invoice",
            "SGS Assay Certificate",
            "Bill of Lading",
            "Certificate of Origin",
            "Phytosanitary Certificate",
            "Form NXP / NESS Clearance"
          ]
        },
        "rfqRefId": {
          "type": "string",
          "minLength": 4,
          "maxLength": 40,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "commodity": {
          "type": "string",
          "minLength": 2,
          "maxLength": 160
        },
        "issuer": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "issuedDate": {
          "type": "string",
          "minLength": 4,
          "maxLength": 40
        },
        "status": {
          "type": "string",
          "enum": ["Verified", "Pending Countersignature", "Archived"]
        },
        "summaryText": {
          "type": "string",
          "minLength": 4,
          "maxLength": 1500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "buyerUid",
        "docCode",
        "title",
        "docType",
        "rfqRefId",
        "commodity",
        "issuer",
        "issuedDate",
        "status",
        "summaryText",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/buyers/{buyerId}": {
      "schema": { "$ref": "#/entities/BuyerProfile" },
      "description": "Private buyer profile and workspace settings keyed by Auth UID."
    },
    "/rfqs/{rfqId}": {
      "schema": { "$ref": "#/entities/BuyerRfq" },
      "description": "Buyer-owned RFQs and LOIs with status tracking."
    },
    "/shipments/{shipmentId}": {
      "schema": { "$ref": "#/entities/BuyerShipment" },
      "description": "Buyer-owned export shipment tracking records."
    },
    "/tradeDocuments/{docId}": {
      "schema": { "$ref": "#/entities/TradeDocument" },
      "description": "Buyer-owned historical and active trade certificates and B/L records."
    }
  }
}
