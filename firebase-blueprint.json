        "destinationPort": { "type": "string", "minLength": 2, "maxLength": 120 },
        "vesselName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "vesselOrContainerRef": { "type": "string", "maxLength": 120 },
        "billOfLadingNo": { "type": "string", "minLength": 2, "maxLength": 80 },
        "containerAllocation": { "type": "string", "minLength": 2, "maxLength": 80 },
        "sgsInspectionStatus": { "type": "string", "maxLength": 80 },
        "stageIndex": { "type": "number" },
        "status": { "type": "string", "enum": ["Mine / Farm Gate", "SGS Assay Verification", "NESS & Customs Cleared", "In Ocean Transit", "Discharged at Port"] },
