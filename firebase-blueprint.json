  "firestore": {
    "/buyers/{buyerId}": {
      "schema": { "$ref": "#/entities/BuyerProfile" },
      "description": "Private buyer profile keyed by Auth UID or admin-synced Lithium Intel buyer records."
    },
    "/rfqs/{rfqId}": {
      "schema": { "$ref": "#/entities/BuyerRfq" },
      "description": "Buyer-owned RFQs and LOIs with Lithium Intel leadRankId linkage."
    },
    "/shipments/{shipmentId}": {
      "schema": { "$ref": "#/entities/BuyerShipment" },
      "description": "Buyer-owned export shipment tracking records."
    },
    "/tradeDocuments/{docId}": {
      "schema": { "$ref": "#/entities/TradeDocument" },
      "description": "Verified trade certificates and formal Document Studio issuances (AZT-PL..AZT-NCN)."
    },
    "/priceAlerts/{alertId}": {
      "schema": { "$ref": "#/entities/PriceAlert" },
      "description": "Commodity price fluctuation alert subscriptions."
    },
    "/siteConfig/{configId}": {
